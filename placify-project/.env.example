# JWT Authentication Secret (override in production)
JWT_SECRET="placify-dev-jwt-secret-change-in-production"

# SQLite Database Path (default: ./placify.db)
DB_PATH="./placify.db"

# Optional MySQL Workbench / Local MySQL Server connection (see database/mysql_schema.sql)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="placify_db"

# Port (default: 3000)
PORT="3000"
